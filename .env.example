# Copy to .env.local. Never commit real credentials or use NEXT_PUBLIC_ names.
# Required for database commands/access; static pages/builds need no credentials.
# Use Neon's pooled PostgreSQL URL with sslmode=require. Separate dev/staging/prod.
DATABASE_URL=
# Reserved for later authentication and image-upload phases.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BLOB_READ_WRITE_TOKEN=
# Password reset email delivery. Use a sender on a domain verified in Resend.
# Keep these server-only. Do not change the existing Better Auth secret for a reset.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
