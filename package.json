  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "db:test": "node --import tsx --test scripts/database.test.ts",
    "auth:bootstrap": "node --import tsx scripts/bootstrap-super-admin.ts",
    "auth:test": "node --conditions=react-server --import tsx --test scripts/auth-database.test.ts scripts/authorization.test.ts"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
